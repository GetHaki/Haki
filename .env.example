# Configuration Haki — copier en `.env` (déjà gitignored) et adapter.
# Variables lues par app/config.py, toutes préfixées HAKI_. Aucune n'est
# strictement obligatoire pour démarrer en local : les défauts ci-dessous
# (LLM_PROVIDER=fake, EMBED_PROVIDER=local) suffisent pour
# `docker compose up -d` + `uv run alembic upgrade head` + `haki verify`,
# sans clé API ni appel réseau. Diagnostic rapide : `bash scripts/doctor.sh`.

# --- Base de données (PostgreSQL 16 + pgvector, voir docker-compose.yml) ---
# Optionnelles : les défauts correspondent déjà au docker-compose.yml fourni.
# Port hôte 5433 (pas 5432 le port Postgres par défaut) — un Postgres
# Windows local occupe souvent déjà 5432, voir le commentaire dans
# docker-compose.yml.

# Rôle applicatif (haki_app), utilisé par l'API au quotidien. Restreint par
# Row-Level Security (migration 0006).
HAKI_DATABASE_URL=postgresql+asyncpg://haki_app:haki@localhost:5433/haki

# Rôle propriétaire (haki), utilisé UNIQUEMENT par Alembic pour les
# migrations (DDL, CREATE EXTENSION). Ne pas utiliser ce rôle pour l'API.
HAKI_MIGRATION_DATABASE_URL=postgresql+asyncpg://haki:haki@localhost:5433/haki

# En PRODUCTION (Supabase, voir docs/DEPLOY.md), les deux URLs ci-dessus
# pointent vers le pooler Supavisor (la connexion directe est IPv6-only,
# injoignable depuis la plupart des réseaux) : mode session (port 5432)
# pour HAKI_MIGRATION_DATABASE_URL, mode transaction (port 6543) pour
# HAKI_DATABASE_URL. Ne JAMAIS mettre le mot de passe réel ici.

# Obligatoire (true) uniquement avec le pooler Supabase en mode transaction
# (HAKI_DATABASE_URL ci-dessus) : désactive le cache de prepared statements
# côté asyncpg, cassé par ce mode de pooling (vérifié empiriquement, voir
# docs/DEPLOY.md). false (défaut) reste correct en local (connexion
# directe, pas de pooler).
HAKI_DB_DISABLE_PREPARED_STATEMENT_CACHE=false

# Policy appliquée par le Policy Engine (scope, audit). Optionnelle,
# "default" convient en local.
HAKI_DEFAULT_POLICY=default

# --- LLM : extraction de faits (consolidation, jamais dans le hot path) ---

# fake = provider simulé, aucune clé requise (défaut, utilisé par les tests
# et par `haki verify`). openai = vrai appel, compatible tout endpoint
# OpenAI-like (OpenAI, OpenRouter, ...). Obligatoire à passer à "openai"
# uniquement pour une vraie extraction ; sinon laisser "fake".
HAKI_LLM_PROVIDER=fake

# Endpoint compatible OpenAI. Ignoré si HAKI_LLM_PROVIDER=fake. Obligatoire
# seulement si HAKI_LLM_PROVIDER=openai. Exemple OpenRouter :
# https://openrouter.ai/api/v1
HAKI_LLM_BASE_URL=https://api.openai.com/v1

# Clé API du provider LLM. JAMAIS de vraie clé dans ce fichier (qui est
# committé) ni ailleurs que dans votre .env local (gitignored). Obligatoire
# seulement si HAKI_LLM_PROVIDER=openai ; laisser vide sinon.
HAKI_LLM_API_KEY=sk-your-provider-key-here

# Modèle utilisé pour l'extraction de faits. Ignoré si provider=fake.
HAKI_LLM_MODEL=gpt-4o-mini

# Modèle d'embedding distant. Utilisé UNIQUEMENT si HAKI_EMBED_PROVIDER=openai
# (le défaut "local" ne l'utilise jamais).
HAKI_LLM_EMBED_MODEL=text-embedding-3-small

# --- Embeddings (chemin critique de /v1/context, cible p95 < 250 ms) ---

# local = ONNX CPU, zéro appel réseau (défaut, recommandé, y compris en
# prod). fake = vecteurs simulés (tests). openai = appel réseau à chaque
# requête (déconseillé, ralentit le hot path). Optionnelle.
HAKI_EMBED_PROVIDER=local

# --- Authentification API (sprint 6) ---

# true (défaut) = chaque endpoint /v1/* exige `Authorization: Bearer hk_...`
# lié à un projet. false = mode dev ouvert, JAMAIS en production (un
# avertissement est loggé au démarrage). Optionnelle.
HAKI_AUTH_REQUIRED=true

# Protège la gestion des clés (POST/GET/DELETE /v1/keys) : seule
# `Authorization: Bearer <admin_key>` peut créer/lister/révoquer des clés.
# Si vide, la PREMIÈRE création de clé est libre (bootstrap documenté),
# ensuite chaque clé ne gère que son propre projet. Optionnelle en dev
# local ; fortement recommandée dès que l'API est exposée au-delà de votre
# machine. Exemple de valeur à choisir vous-même (jamais la valeur ci-dessous
# en réel) :
HAKI_ADMIN_KEY=changeme-local-admin-key

# Secret partage UNIQUEMENT avec le backend Next.js de la console (jamais
# une variable NEXT_PUBLIC_*, jamais envoye au navigateur) pour qu'elle
# puisse appeler POST /v1/orgs/provision au nom d'un utilisateur Clerk deja
# verifie (sprint 11 - signup self-serve). Vide = l'endpoint refuse tout,
# le bootstrap self-hosted/curl via /v1/keys reste inchange. Optionnelle en
# dev local sans console/Clerk branche.
HAKI_CONSOLE_SERVICE_KEY=

# --- CLI device-code auth flow (sprint 14, `haki login`) ---

# Base URL of the console web app: the CLI tells the human to open
# `<HAKI_CONSOLE_BASE_URL>/cli-auth` to approve their device. Optionnelle,
# le défaut convient en local (console Next.js sur le port 3000).
HAKI_CONSOLE_BASE_URL=http://localhost:3000

# Redis (docker-compose.yml) : stocke UNIQUEMENT les codes device/user du
# flow ci-dessus (TTL natif 600s, aucune table Postgres). Optionnelle, le
# défaut correspond déjà au docker-compose.yml fourni.
HAKI_REDIS_URL=redis://localhost:6379/0

# --- Facturation GeniusPay (sprint 12 — remplace l'intégration Stripe
# initialement prévue) ---
# Clé/secret marchand GeniusPay (headers X-API-Key/X-API-Secret, PAS
# Authorization: Bearer). JAMAIS de vraie clé ici (fichier committé) — les
# vraies valeurs vont uniquement dans votre .env local (gitignored).
# Vide = GeniusPayClient refuse de se construire (échec explicite plutôt
# qu'une fonctionnalité payante silencieusement no-op).
HAKI_GENIUSPAY_API_KEY=
HAKI_GENIUSPAY_API_SECRET=

# Secret HMAC pour vérifier POST /v1/webhooks/geniuspay (header
# X-GeniusPay-Signature). Vide = l'endpoint webhook refuse tout (401),
# aucun événement n'est jamais traité sans signature vérifiée. À générer
# dans le dashboard GeniusPay une fois l'endpoint déployé et joignable.
HAKI_GENIUSPAY_WEBHOOK_SECRET=

# Base URL de l'API marchand GeniusPay. Optionnelle, le défaut convient en
# production comme en développement (pas d'environnement sandbox distinct
# confirmé — voir app/billing/geniuspay.py).
HAKI_GENIUSPAY_BASE_URL=https://pay.genius.ci/api/v1/merchant

# Plan unique V1 (pas de sélecteur de plan pour l'instant, limite de
# périmètre documentée). Prix PLACEHOLDER — TODO confirmer le prix XOF réel
# avant d'activer la facturation en production. Optionnelles.
HAKI_BILLING_CLOUD_PLAN_NAME=Cloud
HAKI_BILLING_CLOUD_PLAN_PRICE_XOF=15000

# Clé dev historique (sprint 4) protégeant uniquement l'endpoint MCP
# (`Authorization: Bearer <clé>`). Optionnelle, vide = mode ouvert (local
# uniquement, documenté). Progressivement remplacée par HAKI_AUTH_REQUIRED
# et les clés hk_... ci-dessus.
HAKI_API_KEY=

# --- Serveur MCP (Cursor) ---
# Un serveur MCP = un projet + un sujet, jamais choisi par le modèle
# (invariant sécurité). Optionnelles : les défauts conviennent pour un usage
# solo en local ; à changer si plusieurs personnes partagent une même
# configuration Cursor (chacun son HAKI_MCP_SUBJECT_ID).
HAKI_MCP_PROJECT_ID=prj_cursor_dev
HAKI_MCP_ORG_ID=org_cursor_dev
HAKI_MCP_SUBJECT_ID=usr_cursor_dev

# Consolidation synchrone après chaque haki_capture, pour une mémoire
# immédiatement rappelable. Optionnelle, true par défaut ; passer à false
# si un worker de consolidation séparé prend le relais.
HAKI_MCP_AUTOCONSOLIDATE=true

# --- Classes de volatilité (M2) : horizon de fraîcheur par classe ---
# Au-delà de l'horizon, un fait "slow" reste servi (marqué à reconfirmer),
# un fait "volatile"/"ephemeral" est exclu des faits courants. "stable" n'a
# pas d'horizon (comportement inchangé). Optionnelles, en jours.
HAKI_VOLATILITY_HORIZON_SLOW_DAYS=365
HAKI_VOLATILITY_HORIZON_VOLATILE_DAYS=60
HAKI_VOLATILITY_HORIZON_EPHEMERAL_DAYS=7

# --- Porte de rappel (M3) : plancher de pertinence, désactivée par défaut ---
# Distance cosinus max requête<->mémoire servie. 0 = désactivée (défaut,
# comportement précédent inchangé). Calibrer avec
# scripts/check_recall_floor.py avant d'activer — la bonne valeur dépend de
# HAKI_EMBED_PROVIDER.
# HAKI_RECALL_MAX_DISTANCE=0.75
