{
  "name": "gethaki",
  "version": "0.1.1",
  "description": "TypeScript SDK for Haki — long-term memory for AI agents, with proof",
  "keywords": ["ai", "agents", "memory", "llm", "rag", "context"],
  "homepage": "https://gethaki.space",
  "repository": {
    "type": "git",
    "url": "https://github.com/GetHaki/Haki.git",
    "directory": "sdk/typescript"
  },
  "bugs": "https://github.com/GetHaki/Haki/issues",
  "license": "Apache-2.0",
  "author": "Dicken AI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    }
  },
  "bin": {
    "haki-ts": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/sdk.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "^5.9.0"
  }
}
